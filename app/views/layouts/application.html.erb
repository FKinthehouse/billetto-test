<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Billetto Test" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <style>
      .flash-notice { background: #d4edda; color: #155724; padding: 12px; border-radius: 6px; margin: 10px 0; }
      .flash-alert { background: #f8d7da; color: #721c24; padding: 12px; border-radius: 6px; margin: 10px 0; }
    </style>
  </head>
  <body>
    <% if notice.present? %>
      <div class="flash-notice"><%= notice %></div>
    <% end %>
    <% if alert.present? %>
      <div class="flash-alert"><%= alert %></div>
    <% end %>
    <%= yield %>
  </body>
</html>
